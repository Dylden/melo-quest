{% extends 'admin/base.html.twig' %}


{% block metatitle %}Dashboard{% endblock %}

{% block body %}


    <div class="Container">
        <h1>Dashboard Admin</h1>


        <div>
            <h1>Gérer les utilisateurs</h1>


            <div class="d-flex flex-wrap">
                <table class="table">
                    <thead>
                    <tr>
                        <th scope="col">#</th>
                        <th scope="col">Utilisateur</th>
                        <th scope="col">Email</th>
                        <th scope="col">Rôle</th>
                        <th scope="col">Modifier</th>
                        <th scope="col">Supprimer</th>
                    </tr>
                    </thead>
                    <tbody>

                    {% for user in users %}
                    <tr>
                        <th scope="row">{{ user.id }}</th>
                        <td>{{ user.username }}</td>
                        <td>{{ user.email }}</td>

                        {% for role in user.roles %}
                            <td>{{ role }}</td>
                        {% endfor %}
                        <td><a href="{{ path('admin_update', {'id' : user.id}) }}" class="btn btn-warning">Modifier</a></td>
                        <td><a href="{{ path('admin_delete', {'id' : user.id}) }}" class="btn btn-danger">Supprimer</a></td>
                    </tr>
                    </tbody>
                    {% endfor %}
                </table>
            </div>

        </div>

        <div>
            <h1>Gérer les utilisateurs</h1>


            <div class="d-flex flex-wrap">
                <table class="table">
                    <thead>
                    <tr>
                        <th scope="col">Musiques</th>
                        <th scope="col">Artiste</th>
                        <th scope="col">Modifier</th>
                        <th scope="col">Supprimer</th>
                    </tr>
                    </thead>
                    <tbody>

                    {% for track in tracks %}
                    <tr>
                        <td>{{ track.title }}</td>
                        <td>{{ track.user.username }}</td>

                        <td><a href="{{ path('admin_update_track', {'id' : track.id}) }}" class="btn btn-warning">Modifier</a></td>
                        <td><a href="{{ path('admin_delete_track', {'id' : track.id}) }}" class="btn btn-danger">Supprimer</a></td>
                    </tr>
                    {% endfor %}

                    </tbody>
                </table>
            </div>

        </div>
    </div>
{% endblock %}
