{% extends 'admin/base.html.twig' %}

{% block metatitle %}Modifier l'utilisateur {{ user.username }}{% endblock %}

{% block body %}

    <main>
        <div class="example-wrapper">
            <h1>Modifier l'utilisateur</h1>


            {{ form_start(form_view) }}

            <div>
                {{ form_label(form_view.username) }}
                {{ form_widget(form_view.username) }}
                {{ form_errors(form_view.username) }}
            </div>

            <div>
                {{ form_label(form_view.email) }}
                {{ form_widget(form_view.email) }}
                {{ form_errors(form_view.email) }}
            </div>

            <div>
                {{ form_label(form_view.password) }}
                {{ form_widget(form_view.password) }}
                {{ form_errors(form_view.password) }}
            </div>

            <div>
                {{ form_widget(form_view.submit) }}
            </div>

            {{ form_end(form_view) }}
        </div>
    </main>

{% endblock %}