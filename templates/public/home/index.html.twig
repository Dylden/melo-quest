{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block body %}

    <main>
        <section id="sectionHome">
            <h2>Découvre de <br> nouvelles musiques</h2>

            <form id="searchBar" method="get" action="{{ path('search') }}">
                <label for="search"></label>
                <input id="searchBarInput" type="search" name="search" placeholder="RECHERCHER"
                       value="{{ app.request.query.get('search') }}">
            </form>

            <!-- CAROUSEL -->

            <div class="carousel">
                <button class="prev">⟨</button>

                <div class="carouselTrack">

                    {% for track in recentTracks %}
                        <div class="carouselItem">



                                <div class="coverTrack">
                                    {% if track.cover %}
                                    <a href="{{ path('track_show', {'id': track.id}) }}"><img src="{{ asset('assets/uploads/images/'~track.cover) }}" alt="Image de couverture"></a>

                                    {% else %}

                                        <a href="{{ path('track_show', {'id': track.id}) }}"><div class="cover"></div></a>

                                    {% endif %}
                                </div>



                            <h3>{{ track.title }}</h3>
                            <p>Par {{ track.user.username }}</p>
                        </div>


                    {% else %}

                        <li>Aucune musique ajoutée récemment.</li>

                    {% endfor %}

                </div>

                <button class="next">⟩</button>

            </div>

            <!-- -->
            <div class="flex">
                <div class="trackLibraryContainer">
                    <a href="{{ path('tracks_library') }}">Explorateur de musiques</a>
                </div>
            </div>


        </section>

        <article id="articleHome">
            {% if app.user %}

                <h2 id="test">Partage tes créations</h2>


                <div class="flex">
                    <a href="{{ path('track_create') }}" id="signInButtonMain">Ajouter une musique</a>

                </div>

            {% else %}

                <h2>Inscris-toi pour profiter de</h2>
                <h2>ces fonctionnalités</h2>

                <div class="flex">
                    <a href="{{ path('sign_in') }}" id="signInButtonMain">Inscris-toi</a>
                </div>



            {% endif %}

        </article>
    </main>
    {% block javascripts %}
        <script type="module" src="{{ asset('assets/js/app.js') }}"></script>
    {% endblock %}
{% endblock %}
