{% extends 'base.html.twig' %}

{% block title %} Explorateur de musiques {% endblock %}

{% block body %}


    <h1>Explorateur de musiques</h1>

    <div class="libraryContainer">

        {% for track in tracks %}

            <div class="trackBox">
                <h2>{{ track.title }}</h2>
                <p>{{ track.user.username }}</p>


                {% for genre in track.genres %}
                    <div class="genreFlex">

                        <p>{{ genre.name }}</p>
                    </div>
                {% endfor %}

                <p>{{ track.createdAt | date('d-m-Y') }}</p>

                <div class="buttonContainer">
                    <a href="{{ path('track_show', {'id': track.id}) }}" class="playButton">Play</a>
                </div>
            </div>

        {% endfor %}
    </div>


{% endblock %}