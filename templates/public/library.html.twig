{% extends 'base.html.twig' %}

{% block title %} Explorateur de musiques {% endblock %}

{% block body %}


    <h1>Explorateur de musiques</h1>

        <div class="example-wrapper">
            <h1>Musiques</h1>

            {% for track in tracks %}

                <p>{{ track.id }}</p>
                <p>{{ track.title }}</p>

                {% for genre in track.genres %}
                    <p>{{ genre.name }}</p>
                {% endfor %}

                <p>{{ track.createdAt | date('d-m-Y') }}</p>

                <a href="{{ path('track_show', {'id': track.id}) }}" class="btn btn-primary">Play</a>


            {% endfor %}

        </div>


{% endblock %}