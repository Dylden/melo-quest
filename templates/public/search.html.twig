{% extends 'base.html.twig' %}

{% block title %} Explorateur de musiques {% endblock %}

{% block body %}

    <h1>Résultats de recherche</h1>

    <form id="searchBar" method="get" action="{{ path('search') }}">
        <input type="search" name="search" placeholder="Rechercher" value="{{ app.request.query.get('search') }}" id="searchBar">
    </form>

    <div class="libraryContainer">

        {% for track in tracks %}

            <div class="trackBox">
                <a href="{{ path('track_show', {'id': track.id}) }}"><img src="{{ asset('assets/uploads/images/'~track.cover) }}" alt="Image de couverture"></a>
                <h2>{{ track.title }}</h2>
                <p>{{ track.user.username }}</p>

                {% for genre in track.genres %}
                    <div class="genreFlex">

                        <p>{{ genre.name }}</p>
                    </div>
                {% endfor %}

                <p>{{ track.createdAt | date('d-m-Y') }}</p>

                <div class="buttonContainer">
                    <a href="{{ path('track_show', {'id': track.id}) }}" class="playButton">Play</a>
                </div>
            </div>

        {% endfor %}
    </div>

{% endblock %}