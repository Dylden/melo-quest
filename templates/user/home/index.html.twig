{% extends 'user/user-base.html.twig' %}

{% block title %}Hello HomeController!{% endblock %}

{% block body %}
    <style xmlns="http://www.w3.org/1999/html">
        .example-wrapper {
            margin: 1em auto;
            max-width: 800px;
            width: 95%;
            font: 18px/1.5 sans-serif;
        }

        .example-wrapper code {
            background: #F5F5F5;
            padding: 2px 6px;
        }
    </style>


    <section id="sectionHome">
        <h2>Découvre de</h2>
        <h2>nouvelles musiques</h2>

        <form id="searchBar">
            <label for="search"></label>
            <input id="searchBarInput" type="search" name="search" placeholder="RECHERCHER">
        </form>

        <!-- CAROUSEL -->

        <div class="recentTracks">

            <ul>
                {% for track in recentTracks %}
                    <div class="trackLibraryContainer">
                        <li>
                            <h3>{{ track.title }}</h3>
                            <p>Par {{ track.user.username }}</p>
                        </li>
                    </div>


                {% else %}

                    <li>Aucune musique ajoutée récemment.</li>

                {% endfor %}
            </ul>
        </div>

        <!-- -->

        <div>
            <a href="{{ path('tracks_library') }}">Explorateur de musiques</a>
        </div>


    </section>
    <article id="articleHome">
        <h2>Partage tes créations</h2>


        <div class="flex">
            <a href="{{ path('track_create') }}" id="signInButtonMain">Ajouter une musique</a>

        </div>
    </article>

{% endblock %}

