{% extends 'user/user-base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block body %}
    <style xmlns="http://www.w3.org/1999/html">
        .example-wrapper {
            margin: 1em auto;
            max-width: 800px;
            width: 95%;
            font: 18px/1.5 sans-serif;
        }

        .example-wrapper code {
            background: #F5F5F5;
            padding: 2px 6px;
        }
    </style>


    <section id="sectionHome">
        <h2>Découvre de</h2>
        <h2>nouvelles musiques</h2>

        <form id="searchBar" method="get" action="{{ path('search') }}">
            <label for="search"></label>
            <input id="searchBarInput" type="search" name="search" placeholder="RECHERCHER" value="{{ app.request.query.get('search') }}">
        </form>

        <!-- CAROUSEL -->

        <div class="carousel">
            <button class="prev">⟨</button>

            <div class="carouselTrack">

                {% for track in recentTracks %}
                    <div class="carouselItem">
                        <div class="cover"></div>
                        <h3>{{ track.title }}</h3>
                        <p>Par {{ track.user.username }}</p>
                    </div>


                {% else %}

                    <li>Aucune musique ajoutée récemment.</li>

                {% endfor %}

            </div>

            <button class="next">⟩</button>

        </div>

        <!-- -->
        <div class="flex">
            <div class="trackLibraryContainer">
                <a href="{{ path('tracks_library') }}">Explorateur de musiques</a>
            </div>
        </div>


    </section>
    <article id="articleHome">
        <h2>Partage tes créations</h2>


        <div class="flex">
            <a href="{{ path('track_create') }}" id="signInButtonMain">Ajouter une musique</a>

        </div>
    </article>

{% endblock %}

{% block javascripts %}
    <script type="module" src="{{ asset('assets/js/app.js') }}"></script>
{% endblock %}

