{% extends 'base.html.twig' %}

{% block title %}Profil de {{ user.username }}{% endblock %}

{% block body %}


    <div class="profileContainer">
        <h1>Profil de {{ user.username }}</h1>
        <ul>
            <li>{{ user.email }}</li>
        </ul>

        <h2>Les musiques de {{ user.username }} :</h2>

        <a href="{{ path('tracks_user_list', { 'id': user.id}) }}" id="listUserTracks">Liste musiques</a>


    </div>
{% endblock %}
