{% extends 'base.html.twig' %}

{% block title %}{{ track.title }}{% endblock %}

{% block body %}

    <!-- Lecteur audio -->

    <div class="showTrack">
        <h1 id="showTrackTitle">{{ track.title }}</h1>

        <div class="playerBody">
            <div><img src="{{ asset('assets/uploads/images/'~track.cover) }}" alt="Image de couverture"></div>

            <div class="waveformContainer">
                <div class="audioPlayer">
                    <button id="playPauseBtn" class="showPlayButton"> ></button>
                </div>
                <div id="waveform" data-url="{{ asset('assets/uploads/tracks/' ~ track.filename) }}" class="waveform"></div>
            </div>
            <div class="settings">

                <div class="controls">
                    <div class="volume">
                        <input
                                id="volumeSlider"
                                class="volume-slider"
                                type="range"
                                name="volume-slider"
                                min="0"
                                max="100"
                                value="50"/>
                    </div>
                </div>

                <div class="timecode">
                    <span id="currentTime">00:00:00</span>
                    <span>/</span>
                    <span id="totalDuration">00:00:00</span>
                </div>

            </div>

        </div>
    </div>


    <!-- Création commentaire -->
    <article class="commentsContainer">
        <div class="addCommentContainer">

            {% if app.user %}
                <h2>Ajouter un commentaire</h2>

                {{ form_start(commentForm) }}

                <div>
                    {{ form_widget(commentForm.comment) }}
                    {{ form_errors(commentForm.comment) }}
                </div>

                <div>
                    {{ form_widget(commentForm.submit) }}
                </div>

                {{ form_end(commentForm) }}
            {% else %}
                <h2>Pour ajouter un commentaire, connecte-toi !</h2>

            {% endif %}

        </div>


        <!-- Espace commentaire -->
        <div class="listCommentsContainer">

            <h2>Commentaires</h2>

            {% for comment in comments %}

            <ul>
                <li id="authorsComments">{{ comment.user.username }}</li>

                <li id="commentBox">{{ comment.comment }}</li>
            </ul>

            {% else %}

                <p>Il n'y a pas encore de commentaire, n'hésitez pas à en ajouter un !</p>

            {% endfor %}
        </div>

    </article>

    <!-- Waveform en JS pour la lecture des tracks -->

    <script src="https://unpkg.com/wavesurfer.js@7"></script>
    <script>

        //waveform
        document.addEventListener('DOMContentLoaded', function () {
            // Ici, on crée une instance de WaveSurfer, une bibliothèque JavaScript pour afficher des formes d'onde audio interactives.
            const wavesurfer = WaveSurfer.create({
                container: '#waveform',
                waveColor: '#d5d5d5',
                progressColor: '#ff6a00',
                url: '{{ asset('assets/uploads/tracks/' ~ track.filename) }}',

            });

            //Bouton Play & Pause
            const playPauseBtn = document.getElementById('playPauseBtn');
            playPauseBtn.addEventListener('click', function () {
                if (wavesurfer.isPlaying()) {
                    wavesurfer.pause();
                    playPauseBtn.textContent = '>';
                } else {
                    wavesurfer.play();
                    playPauseBtn.textContent = '||';
                }
            });

            //Timecode
            const currentTime = document.getElementById('currentTime')
            const totalDuration = document.getElementById('totalDuration')

            wavesurfer.on('ready', function() {
                const duration = wavesurfer.getDuration();
                totalDuration.textContent = formatTime(duration);
            });

            wavesurfer.on('audioprocess', function() {
                if(wavesurfer.isPlaying()){
                    const current = wavesurfer.getCurrentTime();
                    currentTime.textContent = formatTime(current);
                }
            });

            wavesurfer.on('seek', function() {
                const current = wavesurfer.getCurrentTime();
                currentTime.textContent = formatTime(current)
            });

            //Contrôle du volume
            const volumeSlider = document.getElementById('volumeSlider');
            volumeSlider.addEventListener('input', function() {
                const volume = volumeSlider.value / 100;
                wavesurfer.setVolume(volume);
            })

            function formatTime(seconds) {
                const hours = Math.floor(seconds / 3600);
                const minutes = Math.floor((seconds % 3600) / 60);
                const secs = Math.floor(seconds % 60);
                return [hours, minutes, secs]
                    .map(unit => String(unit).padStart(2, '0'))
                    .join(':');
            }
        });
    </script>
{% endblock %}


