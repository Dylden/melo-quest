{% extends 'user/user-base.html.twig' %}

{% block title %}Hello TrackController!{% endblock %}

{% block body %}

    <style>
        .example-wrapper {
            margin: 1em auto;
            max-width: 800px;
            width: 95%;
            font: 18px/1.5 sans-serif;
        }

        .example-wrapper code {
            background: #F5F5F5;
            padding: 2px 6px;
        }
    </style>


    <div class="showTrack">

        <h1 id="showTrackTitle">{{ track.title }}</h1>

        <div class="audioPlayer">
            <button id="playPauseBtn" class="showPlayButton"> > </button>
        </div>

        <div class="playerBody">
            <p class="trackTitle">{{ track.title }}</p>
            <div id="waveform" data-url="{{ asset('assets/uploads/tracks/' ~ track.filename) }}" class="waveform"></div>

            <div class="controls">
                <div class="volume">
                    <input
                    id="volumeSlider"
                    class="volume-slider"
                    type="range"
                    name="volume-slider"
                    min="0"
                    max="100"
                    value="50"/>
                </div>

                <div class="timecode">
                    <span id="currentTime">00:00:00</span>
                    <span>/</span>
                    <span id="totalDuration">00:00:00</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Waveform en JS pour la lecture des tracks -->

    <script src="https://unpkg.com/wavesurfer.js@7"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const wavesurfer = WaveSurfer.create({
                container: '#waveform',
                waveColor: '#d5d5d5',
                progressColor: '#ff6a00',
                url: '{{ asset('assets/uploads/tracks/' ~ track.filename) }}',

            });

            const playPauseBtn = document.getElementById('playPauseBtn');
            playPauseBtn.addEventListener('click', function () {
                if (wavesurfer.isPlaying()) {
                    wavesurfer.pause();
                    playPauseBtn.textContent = '>';
                } else {
                    wavesurfer.play();
                    playPauseBtn.textContent = '||';
                }
            });
        });
    </script>
{% endblock %}


