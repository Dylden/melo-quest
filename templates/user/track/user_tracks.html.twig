{% extends 'base.html.twig' %}

{% block title %}Musiques de {{ user.username }}{% endblock %}

{% block body %}
    <style>
        .example-wrapper {
            margin: 1em auto;
            max-width: 800px;
            width: 95%;
            font: 18px/1.5 sans-serif;
        }

        .example-wrapper code {
            background: #F5F5F5;
            padding: 2px 6px;
        }
    </style>

    <div class="userTracksContainer">

        <h1>Musiques</h1>

        <div class="libraryContainer">


            {% for track in tracks %}

                <div class="trackBox">
                    <h2>{{ track.title }}</h2>

                    {% for genre in track.genres %}
                        <div class="genreFlex">
                            <p>{{ genre.name }}</p>

                        </div>
                    {% endfor %}

                    <p>{{ track.createdAt | date('d-m-Y') }}</p>

                    <div class="buttonContainer">
                        <a href="{{ path('track_show', {'id': track.id}) }}" class="btn btn-primary">Play</a>
                    </div>
                    <div>
                        <a href="{{ path('track_update', {'id' : track.id}) }}" class="btn btn-warning">Modifier</a>
                        <a href="{{ path('track_delete', {'id' : track.id}) }}" class="btn btn-danger">Supprimer</a>
                    </div>

                </div>



            {% endfor %}
        </div>

    </div>
{% endblock %}
